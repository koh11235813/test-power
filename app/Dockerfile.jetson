# base image
FROM nvcr.io/nvidia/l4t-jetpack:r36.3.0

# ENV DEBIAN_FRONTEND=noninteractive

# ---
RUN apt-get update && apt-get upgrade -y
RUN apt-get update && apt-get install -y --fix-missing \
    python3-pip \
    git \
    libjpeg-dev \
    zlib1g-dev \
    libopenblas-dev \
    libpng-dev \
    libgl1 \
    ninja-build \
    wget \
    zlib1g-dev \
    libpython3-dev \
    ffmpeg \
    libavutil-dev \
    libavcodec-dev \
    libavformat-dev \
    libavdevice-dev \
    libavfilter-dev \
    libswscale-dev \
    libswresample-dev \
    libpostproc-dev \
    libopenmpi-dev

RUN apt-get clean

RUN rm -rf /var/lib/apt/lists/*

# ImportError: libcusparseLt.so.0: cannot open shared object file: No such file or directory
RUN wget https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2204/arm64/cuda-keyring_1.1-1_all.deb \
    && dpkg -i cuda-keyring_1.1-1_all.deb \
    && rm cuda-keyring_1.1-1_all.deb \
    && apt-get update \
    && apt-get -y install libcusparselt0 libcusparselt-dev \
    libcublas-12-6 \
    libnvtoolsext1 \
    cuda-libraries-12-6 \
    cuda-12-6

# numpy < 2.0
RUN pip3 install --no-cache-dir "numpy<2.0"

# --- install torch 2.5 build by nVIDIA  ---
RUN wget https://developer.download.nvidia.com/compute/redist/jp/v61/pytorch/torch-2.5.0a0+872d972e41.nv24.08.17622132-cp310-cp310-linux_aarch64.whl \
    && pip3 install torch-2.5.0a0+872d972e41.nv24.08.17622132-cp310-cp310-linux_aarch64.whl \
    && rm torch-2.5.0a0+872d972e41.nv24.08.17622132-cp310-cp310-linux_aarch64.whl


# install torchvision 0.20.0, depends on torch 2.5
RUN git clone --branch v0.20.0 https://github.com/pytorch/vision torchvision \
    && cd torchvision \
    && pip3 install .\
    && cd ../ \
    && rm -rf torchvision

# --- step3: install ultralytics---
RUN pip3 install --no-cache-dir ultralytics grpcio grpcio-tools

# --- set daemon script---
COPY scripts /scripts
RUN chmod +x /scripts -R

CMD ["python","/scripts/grpc-server.py"]

